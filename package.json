{
  "name": "easyasso",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && (prisma migrate deploy || echo 'DB not reachable — skipping migrations') && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "15.1.6",
    "next-auth": "^4.24.11",
    "@auth/prisma-adapter": "^2.7.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "bcryptjs": "^2.4.3",
    "zod": "^3.24.1",
    "stripe": "^17.5.0",
    "lucide-react": "^0.474.0",
    "clsx": "^2.1.1",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
